
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en" data-theme-mode="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Reflect Provider Dashboard</title>
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/assets/libs/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/libs/remixicon/fonts/remixicon.css" asp-append-version="true" />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <!-- Provider Theme CSS -->
    @* During incremental migration, only screens declaring their own styles skip the demo layout's fallback. *@
    @if (ViewData["ProviderScreenOwnsStyles"] is not true)
    {
        <link rel="stylesheet" href="~/css/provider.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/standins/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/standins/provider-shell.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Mobile Overlay -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <div class="provider-root">
        <!-- Sidebar Navigation -->
        <nav class="provider-sidebar" id="providerSidebar">
            <div class="sidebar-brand-wrapper">
                <a href="@Url.Action("IndexPage", "Overview", new { area = "Provider" })" class="sidebar-brand">
                    <img src="~/images/logos/reflect-horizontal-logo-white-rgb.svg" alt="Reflect XR" class="brand-full-logo" />
                    <img src="~/images/logos/reflect-logo-mark-white-rgb.svg" alt="Reflect XR" class="brand-mark-logo" />
                </a>
                <div class="brand-badge">PROVIDER DASHBOARD</div>
            </div>

            <ul class="sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Overview" ? "active" : "")" href="/Provider/Overview/IndexPage">
                        <i class="ri-dashboard-line nav-icon" aria-hidden="true"></i>
                        <span>Overview</span>
                    </a>
                </li>


                
                <li class="nav-item">
                    <a class="nav-link @(
                        ViewContext.RouteData.Values["controller"]?.ToString() == "PatientSessionHistory" ||
                        (
                            ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" &&
                            ViewContext.RouteData.Values["action"]?.ToString() == "SessionDetails"
                        )
                        ? "active" : "")"
                    href="@Url.Action("IndexPage", "PatientSessionHistory", new { area = "Provider" })">
                        <i class="ri-history-line nav-icon" aria-hidden="true"></i>
                        <span>Session History</span>
                    </a>
                </li>



                
                <li class="nav-item">
                    <a class="nav-link @(
                        ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" &&
                        ViewContext.RouteData.Values["action"]?.ToString() != "SessionDetails"
                        ? "active" : "")"
                    href="/Provider/Patients/IndexPage">
                        <i class="ri-group-line nav-icon" aria-hidden="true"></i>
                        <span>Patients</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Progress" ? "active" : "")" href="/Provider/Progress/IndexPage">
                        <i class="ri-bar-chart-line nav-icon"></i>
                        <span>Progress</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MonitoringDocumentation" ? "active" : "")" href="/Provider/MonitoringDocumentation/IndexPage">
                        <i class="ri-clipboard-line nav-icon"></i>
                        <span>Monitoring</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" href="/Provider/Reports/IndexPage">
                        <i class="ri-file-text-line nav-icon"></i>
                        <span>Reports</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="sidebar-settings">
                    <a href="/Provider/Settings/IndexPage" class="settings-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" title="Settings">
                        <i class="ri-settings-3-line me-2"></i><span>Settings</span>
                    </a>
                </div>
                <div class="sidebar-user dropdown">
                    <button type="button"
                            class="sidebar-profile-button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Open account menu">
                        <span class="user-avatar">SM</span>
                        <span class="user-details">
                            <span class="user-name">Dr. Sarah Mitchell</span>
                        </span>
                        <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
                    </button>

                    <ul class="dropdown-menu">
                        <li>
                            <span class="dropdown-header">Dr. Sarah Mitchell</span>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="Provider"
                                asp-controller="Auth"
                                asp-action="Logout"
                                method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="ri-logout-box-line" aria-hidden="true"></i>
                                    Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content Layout -->
        <div class="provider-main">
            <!-- Global Top Bar -->
            <header class="provider-header">
                <div style="display:flex;align-items:center;">
                    <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Toggle menu">
                        <i class="ri-menu-line" aria-hidden="true"></i>
                    </button>
                    <div class="header-title-group">
                        <nav aria-label="Breadcrumb">
                            <ol class="provider-breadcrumb">
                                <li>
                                    <a href="@Url.Action("Index", "Overview", new { area = "Provider" })">
                                        Overview
                                    </a>
                                </li>
                                @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Overview")
                                {
                                    <li aria-current="page">@ViewData["Title"]</li>
                                }
                            </ol>
                        </nav>

                        <h1 class="page-title">@ViewData["Title"]</h1>

                        @if (ViewData["Subtitle"] != null)
                        {
                            <span class="header-subtitle">@ViewData["Subtitle"]</span>
                        }
                    </div>
                </div>
                <div class="header-controls">
                 
                    <div class="accessibility-wrapper">
                        <button type="button"
                                id="accessibilityToggle"
                                class="theme-toggle-btn"
                                aria-label="Accessibility settings"
                                aria-expanded="false"
                                aria-controls="accessibilityPanel"
                                title="Accessibility settings">
                            <i class="ri-wheelchair-line" aria-hidden="true"></i>
                            <span class="accessibility-button-label">Accessibility</span>
                        </button>

                        <section id="accessibilityPanel"
                                class="accessibility-panel"
                                aria-label="Accessibility settings"
                                hidden>

                            <h2 class="accessibility-heading">Accessibility Settings</h2>

                            <div class="accessibility-field">
                                <label for="accessibilityTheme">Theme</label>
                                <select id="accessibilityTheme" class="accessibility-select">
                                    <option value="light">Light</option>
                                    <option value="dark">Dark</option>
                                </select>
                            </div>

                            <div class="accessibility-field">
                                <label class="accessibility-checkbox-label">
                                    <input type="checkbox" id="accessibilityColorblind" />
                                    Color-blind friendly mode
                                </label>
                            </div>

                            <div class="accessibility-field">
                                <label for="accessibilityTextSize">Text size</label>
                                <select id="accessibilityTextSize" class="accessibility-select">
                                    <option value="100">Normal (100%)</option>
                                    <option value="112.5">Large (112.5%)</option>
                                    <option value="125">Extra Large (125%)</option>
                                </select>
                            </div>

                        </section>
                    </div>

                  
                    <span class="demo-badge">DEMO DATA</span>
                </div>
            </header>

            <!-- Main Page View Content -->
            <main class="provider-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (ViewData["ProviderScreenOwnsChartJs"] is not true)
    {
        <script src="~/assets/libs/chartjs/chart.umd.js" asp-append-version="true"></script>
    }
    <script src="~/standins/provider-shell.js" asp-append-version="true"></script>
    <script src="~/standins/shared-services.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
