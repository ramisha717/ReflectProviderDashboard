
@model Reflect.Web.Models.ViewModels.Progress.Index.ProgressIndexViewModel
@using System.Text.Json

@{
    ViewData["ProviderScreenOwnsStyles"] = true;
    ViewData["ProviderScreenOwnsChartJs"] = true;
    ViewData["Title"] = "Progress";
    ViewData["Subtitle"] = "Review patient engagement trends and session activity.";

    var chartData = new
    {
        labels = Model.WeeklyActivity.Select(w => $"Week {w.WeekNumber}"),
        xr = Model.WeeklyActivity.Select(w => w.ReflectXRSessions),
        mobile = Model.WeeklyActivity.Select(w => w.ReflectMobileSessions),
        durationLabels = Model.DurationBuckets.Select(b => b.Label),
        durationCounts = Model.DurationBuckets.Select(b => b.SessionCount)
    };

    var chartJson = JsonSerializer.Serialize(chartData);

    var xrTotal = Model.WeeklyActivity.Sum(w => w.ReflectXRSessions);
    var mobileTotal = Model.WeeklyActivity.Sum(w => w.ReflectMobileSessions);
    var platformTotal = xrTotal + mobileTotal;

    var xrPercent = platformTotal == 0
        ? 0
        : Math.Round(100.0 * xrTotal / platformTotal, 1);

    var mobilePercent = platformTotal == 0
        ? 0
        : Math.Round(100.0 * mobileTotal / platformTotal, 1);
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-primary-navy"
       href="@Url.Action("PlatformComparisonPage", "Progress", new { area = "Provider", days = Model.SelectedDays })">
        <i class="ri-bar-chart-grouped-line me-1" aria-hidden="true"></i>
        Compare XR vs Mobile
    </a>
</div>

<div id="progress-dashboard" data-chart="@chartJson">


<!-- Reporting period -->
<div class="filter-toolbar mb-4">
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="fw-semibold">Reporting period:</span>

        <div class="filter-pills">
            <a class="pill-btn @(Model.SelectedDays == 30 ? "active" : "")"
               href="@Url.Action("Index", "Progress", new { area = "Provider", days = 30 })"
               aria-current="@(Model.SelectedDays == 30 ? "page" : null)">
                4 weeks
            </a>

            <a class="pill-btn @(Model.SelectedDays == 60 ? "active" : "")"
               href="@Url.Action("Index", "Progress", new { area = "Provider", days = 60 })"
               aria-current="@(Model.SelectedDays == 60 ? "page" : null)">
                8 weeks
            </a>
        </div>
    </div>
</div>


    <!-- Summary metrics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dash-card h-100">
                <div class="dash-card-body">
                    <div class="text-muted mb-2">Total Sessions</div>
                    <div class="fs-2 fw-bold">@Model.TotalSessions</div>
                    <div class="small text-muted">
                        Sessions recorded during the reporting period
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dash-card h-100">
                <div class="dash-card-body">
                    <div class="text-muted mb-2">Active Days</div>
                    <div class="fs-2 fw-bold">@Model.ActiveDays</div>
                    <div class="small text-muted">
                        Days with recorded session activity
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="dash-card h-100">
                <div class="dash-card-body">
                    <div class="text-muted mb-2">Median Session Duration</div>
                    <div class="fs-2 fw-bold">
                        @Model.MedianDurationMinutes.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
                        <span class="fs-6 fw-normal">min</span>
                    </div>
                    <div class="small text-muted">
                        Median duration across recorded sessions
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Weekly activity -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-8">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h2 class="dash-card-title">
                        Weekly Session Activity
                    </h2>
                </div>

                <div class="dash-card-body">
                    <p class="small text-muted">
                        Number of Reflect XR and Reflect Mobile sessions
                        recorded each week.
                    </p>

                    <div style="height:300px;position:relative;">
                        <canvas id="progress-weekly-chart"
                                role="img"
                                aria-label="Weekly session counts for Reflect XR and Reflect Mobile">
                        </canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Platform totals -->
        <div class="col-12 col-lg-4">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h2 class="dash-card-title">
                        XR vs Mobile Usage
                    </h2>
                </div>

                <div class="dash-card-body">

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Reflect XR</span>
                            <strong>@xrTotal sessions</strong>
                        </div>

                        <div class="progress" style="height:12px;">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width:@(xrPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;background:var(--primary-navy);"
                                 aria-valuenow="@xrPercent"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-label="Reflect XR usage">
                            </div>
                        </div>

                        <div class="small text-muted mt-1">
                            @xrPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
                        </div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Reflect Mobile</span>
                            <strong>@mobileTotal sessions</strong>
                        </div>

                        <div class="progress" style="height:12px;">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width:@(mobilePercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%;background:var(--accent-coral);"
                                 aria-valuenow="@mobilePercent"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-label="Reflect Mobile usage">
                            </div>
                        </div>

                        <div class="small text-muted mt-1">
                            @mobilePercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Duration distribution -->
    <div class="dash-card mb-4">
        <div class="dash-card-header">
            <h2 class="dash-card-title">
                Session Duration Distribution
            </h2>
        </div>

        <div class="dash-card-body">
            <div class="row g-4">

                <div class="col-12 col-lg-7">
                    <div style="height:280px;position:relative;">
                        <canvas id="progress-duration-chart"
                                role="img"
                                aria-label="Distribution of sessions by duration">
                        </canvas>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Duration</th>
                                    <th scope="col">Sessions</th>
                                    <th scope="col">Percentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bucket in Model.DurationBuckets)
                                {
                                    <tr>
                                        <td>@bucket.Label</td>
                                        <td>@bucket.SessionCount</td>
                                        <td>@bucket.Percentage.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @if (Model.TotalSessions == 0)
    {
        <div class="alert alert-info" role="status">
            No session activity was recorded during this reporting period.
        </div>
    }

</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/controllers/progress/indexController.js"
            asp-append-version="true"
            defer></script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/provider.css" asp-append-version="true" />
}
