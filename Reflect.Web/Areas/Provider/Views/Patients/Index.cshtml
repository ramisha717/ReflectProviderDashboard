
@{
    ViewData["ProviderScreenOwnsStyles"] = true;
    ViewData["Title"] = "Patients";
    ViewData["Subtitle"] = "Find and review patient engagement records · Synthetic records only.";

    var dataUrl = Url.Action("Index", "Patients", new { area = "Provider", format = "json" });
    var profileUrl = Url.Action("Profile", "Patients", new { area = "Provider" });
    var addDemoUrl = Url.Action("AddDemo", "Patients", new { area = "Provider" });
}

<!-- Filter & Search Toolbar -->
<div class="filter-toolbar">
    <div class="table-search-box">
        <i class="ri-search-line search-icon" aria-hidden="true"></i>
        <input type="text"
               id="patient-search-input"
               class="table-search-input"
               placeholder="Search by patient ID"
               aria-label="Search patients" />
    </div>

    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <div class="filter-pills"
             role="group"
             aria-label="Filter patients">
            <button class="pill-btn active"
                    id="filter-all"
                    type="button"
                    aria-pressed="true">
                All profiles
            </button>

            <button class="pill-btn"
                    id="filter-review"
                    type="button"
                    aria-pressed="false">
                Needs review
            </button>

            <button class="pill-btn"
                    id="filter-active"
                    type="button"
                    aria-pressed="false">
                Active
            </button>
        </div>

        <button class="btn-add-demo"
                id="btn-open-add-modal"
                type="button">
            <i class="ri-add-line" aria-hidden="true"></i>
            Add demo profile
        </button>
    </div>
</div>

<!-- Patients Table Card -->
<div class="table-card">
    <div id="patients-loading" class="loading-state">
        <div class="spinner-border text-primary spinner-border-sm me-2"
             role="status"
             aria-hidden="true"></div>
        <span>Loading patient records…</span>
    </div>

    <div id="patients-error"
         class="alert alert-danger m-3 d-none"
         role="alert"></div>

    <div id="patients-empty"
         class="alert alert-warning m-3 d-none"
         role="status">
        No matching patient records found.
    </div>

    <div class="table-responsive">
        <table id="patients-table" class="patients-table d-none">
            <caption class="visually-hidden">
                Patient engagement records. Sortable columns include patient,
                last active date, session count, and review status.
            </caption>

            <thead>
                <tr>
                    <th class="sortable"
                        data-sort="patient"
                        scope="col"
                        aria-sort="none">
                        PATIENT
                        <span class="sort-icon ri-arrow-up-down-line"
                              aria-hidden="true"></span>
                    </th>

                    <th class="sortable"
                        data-sort="date"
                        scope="col"
                        aria-sort="descending">
                        LAST ACTIVE
                        <span class="sort-icon ri-sort-desc"
                              aria-hidden="true"></span>
                    </th>

                    <th class="sortable"
                        data-sort="sessions"
                        scope="col"
                        aria-sort="none">
                        SESSIONS
                        <span class="sort-icon ri-arrow-up-down-line"
                              aria-hidden="true"></span>
                    </th>

                    <th scope="col">PLATFORM</th>
                    <th scope="col">TREND</th>

                    <th class="sortable"
                        data-sort="status"
                        scope="col"
                        aria-sort="none">
                        STATUS
                        <span class="sort-icon ri-arrow-up-down-line"
                              aria-hidden="true"></span>
                    </th>

                    <th scope="col">PROFILE</th>
                </tr>
            </thead>

            <tbody id="patients-tbody"></tbody>
        </table>
    </div>

    <!-- Table Footer -->
    <div class="table-footer d-flex justify-content-between align-items-center">
        <span>
            Showing <span id="displayed-count">0</span> of
            <span id="total-count">0</span> synthetic patient records
        </span>

        <span style="color:var(--text-light);font-size:0.6875rem;">
            <i class="ri-information-line me-1" aria-hidden="true"></i>
            Click headers to sort, or use Enter or Space
        </span>
    </div>
</div>

<!-- Add Demo Profile Modal -->
<div class="modal fade"
     id="addPatientModal"
     tabindex="-1"
     aria-labelledby="addPatientModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow"
             style="border-radius:var(--card-radius);">

            <div class="modal-header"
                 style="background:var(--bg-table-header);border-bottom:1px solid var(--border-light);">

                <h5 class="modal-title fw-bold"
                    id="addPatientModalLabel"
                    style="font-size:0.9375rem;color:var(--text-dark);">
                    <i class="ri-user-add-line me-2"
                       style="color:var(--primary-navy);"
                       aria-hidden="true"></i>
                    Add Demo Patient Profile
                </h5>

                <button type="button"
                        class="btn-close"
                        id="btn-close-modal-x"
                        aria-label="Close"></button>
            </div>

            <form id="add-patient-form">
                @Html.AntiForgeryToken()

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label"
                               for="new-patient-code"
                               style="font-size:0.6875rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.03125rem;">
                            PATIENT CODE / NAME
                        </label>

                        
                    <input type="text"
                        id="new-patient-code"
                        class="form-control"
                        placeholder="e.g. RX-RX-00F3A7B5"
                        required
                        style="border-radius:var(--btn-radius);" />

                    </div>

                    <div class="mb-3">
                        <label class="form-label"
                               for="new-patient-status"
                               style="font-size:0.6875rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.03125rem;">
                            REVIEW STATUS
                        </label>

                        <select id="new-patient-status"
                                class="form-select"
                                style="border-radius:var(--btn-radius);">
                            <option value="Needs Review">Needs Review</option>
                            <option value="Reviewed" selected>Reviewed</option>
                        </select>
                    </div>

                    <p class="small mb-2"
                       style="color:var(--text-muted);">
                        New profiles start with zero sessions. Platform and trend
                        are calculated from recorded sessions.
                    </p>

                    <div id="add-patient-error"
                         class="alert alert-danger d-none"
                         role="alert"></div>
                </div>

                <div class="modal-footer"
                     style="background:var(--bg-table-header);border-top:1px solid var(--border-light);">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            id="btn-cancel-modal"
                            style="border-radius:var(--btn-radius);">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-sm px-3 btn-primary-navy"
                            style="border-radius:var(--btn-radius);">
                        <i class="ri-check-line me-1"
                           aria-hidden="true"></i>
                        Save Demo Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Slide-over Patient Profile Drawer -->
<div class="patient-profile-drawer"
     id="profileOffcanvas"
     role="dialog"
     aria-modal="true"
     aria-labelledby="profile-drawer-patient-name"
     aria-hidden="true">

    <!-- Drawer Header -->
    <div class="p-3 border-bottom"
         style="background:var(--bg-table-header);">

        <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="flex-grow-1" style="min-width:0;">

                <a href="#"
                   class="text-decoration-none small d-inline-flex align-items-center mb-1"
                   id="drawer-back-btn"
                   style="color:var(--text-muted);">
                    <i class="ri-arrow-left-line me-1"
                       aria-hidden="true"></i>
                    Back to patients
                </a>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h4 class="fw-bold mb-0"
                        id="profile-drawer-patient-name"
                        style="color:var(--text-dark);font-size:1.125rem;">
                        Patient Profile
                    </h4>

                    <span id="profile-drawer-status-badge"
                          class="badge"></span>
                </div>

                <div class="small mt-1"
                     id="profile-drawer-sub"
                     style="color:var(--text-muted);">
                    Longitudinal view across Reflect XR and Reflect Mobile
                </div>
            </div>

            <button type="button"
                    class="btn-close flex-shrink-0"
                    id="drawer-close-x"
                    aria-label="Close"></button>
        </div>

        <!-- Drawer Navigation -->
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            
            <a id="drawer-nav-notes"
            href="@Url.Action("IndexPage", "ClinicalResponse", new { area = "Provider" })"
            class="btn btn-sm btn-outline-secondary">
                <i class="ri-file-text-line me-1" aria-hidden="true"></i>
                Clinical Response &amp; Observations
            </a>


            <a id="drawer-nav-session"
               asp-area="Provider"
               asp-controller="Patients"
               asp-action="SessionDetails"
               class="btn btn-sm btn-outline-secondary">
                <i class="ri-eye-line me-1"
                   aria-hidden="true"></i>
                Latest Session
            </a>
        </div>
    </div>

    <!-- Drawer Body -->
    <div class="p-4"
         style="overflow-y:auto;flex:1;min-height:0;"
         id="profile-drawer-body">

        <div id="profile-drawer-loading"
             class="text-center py-5"
             role="status"
             aria-live="polite">
            <div class="spinner-border"
                 aria-hidden="true"
                 style="color:var(--primary-navy);"></div>

            <p class="small mt-2"
               style="color:var(--text-muted);">
                Loading patient profile data…
            </p>
        </div>

        <div id="profile-drawer-content" class="d-none">

            <!-- KPI Cards -->
            <div class="kpi-grid"
                 style="grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:1.25rem;">

                <div class="kpi-card">
                    <div class="kpi-label">Total Sessions</div>

                    <div class="kpi-value"
                         id="drawer-total-sessions"
                         style="font-size:1.5rem;">
                        0
                    </div>

                    <div class="kpi-sub" id="drawer-platform-split">
                        Reflect XR + Mobile
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Total Duration</div>

                    <div class="kpi-value"
                         id="drawer-duration"
                         style="font-size:1.5rem;">
                        0 min
                    </div>

                    <div class="kpi-sub" id="drawer-engagement-desc">
                        Recorded patient activity
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Last Active</div>

                    <div class="kpi-value"
                         id="drawer-last-active"
                         style="font-size:1.125rem;">
                        -
                    </div>

                    <div class="kpi-sub" id="drawer-last-module">
                        -
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-label">Most-Used Platform</div>

                    <div class="kpi-value"
                         id="drawer-top-platform"
                         style="font-size:1.125rem;">
                        -
                    </div>

                    <div class="kpi-sub" id="drawer-platform-sessions">
                        Primary modality
                    </div>
                </div>
            </div>

            <!-- Platform Mix -->
            <div class="dash-card" style="margin-bottom:1rem;">
                <div class="dash-card-header"
                     style="padding:0.875rem 1.25rem;">

                    <h3 class="dash-card-title"
                        style="font-size:0.75rem;">
                        Platform Mix
                    </h3>

                    <span class="small"
                          id="drawer-platform-mix-label"
                          style="color:var(--text-muted);font-size:0.6875rem;">
                        Modality split
                    </span>
                </div>

                <div class="dash-card-body"
                     style="padding:0.875rem 1.25rem;">

                    <div class="progress"
                         style="height:0.625rem;border-radius:0.3125rem;">

                        <div id="drawer-progress-xr"
                             class="progress-bar"
                             role="progressbar"
                             aria-label="Reflect XR session share"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="0"
                             style="width:50%;background:var(--primary-navy);"></div>

                        <div id="drawer-progress-mobile"
                             class="progress-bar"
                             role="progressbar"
                             aria-label="Reflect Mobile session share"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="0"
                             style="width:50%;background:var(--accent-coral);"></div>
                    </div>

                    <div class="d-flex justify-content-between small mt-2"
                         style="color:var(--text-muted);">

                        <span>
                            <i class="ri-circle-fill me-1"
                               style="font-size:0.5rem;color:var(--primary-navy);"
                               aria-hidden="true"></i>
                            Reflect XR:
                            <strong id="drawer-xr-count">0</strong>
                        </span>

                        <span>
                            <i class="ri-circle-fill me-1"
                               style="font-size:0.5rem;color:var(--accent-coral);"
                               aria-hidden="true"></i>
                            Mobile:
                            <strong id="drawer-mobile-count">0</strong>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Weekly Engagement -->
            <div class="dash-card" style="margin-bottom:1rem;">
                <div class="dash-card-header"
                     style="padding:0.875rem 1.25rem;">

                    <h3 class="dash-card-title"
                        style="font-size:0.75rem;">
                        Weekly Engagement
                    </h3>

                    <span class="small"
                          style="color:var(--text-muted);font-size:0.6875rem;">
                        Last 8 weeks · Minutes
                    </span>
                </div>

                <div class="dash-card-body"
                     style="padding:1rem 1.25rem;">

                    <div id="drawer-weekly-engagement"
                         role="group"
                         aria-label="Weekly engagement for the last eight weeks, comparing Reflect XR and Reflect Mobile minutes"
                         style="display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:0.5rem;align-items:end;min-height:11.25rem;">
                    </div>

                    <div class="d-flex gap-3 mt-3 small"
                         style="color:var(--text-muted);">

                        <span>
                            <i class="ri-circle-fill me-1"
                               style="font-size:0.5rem;color:var(--primary-navy);"
                               aria-hidden="true"></i>
                            Reflect XR
                        </span>

                        <span>
                            <i class="ri-circle-fill me-1"
                               style="font-size:0.5rem;color:var(--accent-coral);"
                               aria-hidden="true"></i>
                            Reflect Mobile
                        </span>
                    </div>
                </div>
            </div>

            <!-- Session History -->
            <div class="dash-card">
                <div class="dash-card-header"
                     style="padding:0.75rem 1.25rem;">

                    <h3 class="dash-card-title"
                        style="font-size:0.75rem;">
                        Session History
                    </h3>
                </div>

                <div class="table-responsive"
                     style="max-height:17.5rem;overflow-y:auto;">

                    <table class="attention-table"
                           style="font-size:0.8125rem;">

                        <caption class="visually-hidden">
                            Patient session history with dates, platforms,
                            modules, durations, and recording statuses.
                        </caption>

                        <thead>
                            <tr>
                                <th scope="col"
                                    style="padding:0.5rem 1.25rem;">
                                    DATE
                                </th>

                                <th scope="col"
                                    style="padding:0.5rem 1.25rem;">
                                    PLATFORM
                                </th>

                                <th scope="col"
                                    style="padding:0.5rem 1.25rem;">
                                    MODULE
                                </th>

                                <th scope="col"
                                    style="padding:0.5rem 1.25rem;">
                                    DURATION
                                </th>

                                <th scope="col"
                                    style="padding:0.5rem 1.25rem;">
                                    STATUS
                                </th>
                            </tr>
                        </thead>

                        <tbody id="drawer-sessions-tbody"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Patient AJAX Configuration -->
<div id="patients-config"
     data-index-url="@dataUrl"
     data-profile-url="@profileUrl"
     data-add-demo-url="@addDemoUrl"
     hidden></div>

@section Styles {
    <link rel="stylesheet" href="~/css/provider.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/controllers/patients/dateFormatting.js" asp-append-version="true"></script>
    <script src="~/js/services/patients/indexService.js"
            asp-append-version="true"></script>

    <script src="~/js/controllers/patients/indexController.js"
            asp-append-version="true"></script>
}


