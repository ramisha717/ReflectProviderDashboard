@{
    Layout = "_ProviderLayout";
    ViewData["Title"] = "Monitoring — Documentation";
    ViewData["Subtitle"] = "Prepare a clinician-reviewed summary from selected activity.";
    var patientsUrl = Url.Action("Index", "Patients", new { area = "Provider", format = "json" });
    var summaryUrl = Url.Action("Index", "MonitoringDocumentation", new { area = "Provider", format = "json" });
    var regenerateUrl = Url.Action("Regenerate", "MonitoringDocumentation", new { area = "Provider" });
    var saveUrl = Url.Action("SaveDraft", "MonitoringDocumentation", new { area = "Provider" });
    var reviewUrl = Url.Action("MarkReviewed", "MonitoringDocumentation", new { area = "Provider" });
}

@section Styles {
    <link rel="stylesheet" href="~/css/monitoring-documentation.css" asp-append-version="true" />
}

<div class="monitoring-page" id="monitoring-root"
     data-patients-url="@patientsUrl"
     data-summary-url="@summaryUrl"
     data-regenerate-url="@regenerateUrl"
     data-save-url="@saveUrl"
     data-review-url="@reviewUrl"
     data-initial-patient-code="@ViewBag.PatientCode">

    <div class="monitoring-prototype-note">
        <span class="monitoring-prototype-label">PROTOTYPE · SYNTHETIC DATA</span>
        <span>UX prototype only — not for clinical use.</span>
    </div>

    <div class="content-header monitoring-heading">
        <div>
            <h2 class="content-title">Progress summary</h2>
            <p class="content-subtitle">Draft a neutral overview of recorded engagement for clinician review.</p>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <div class="monitoring-columns">
        <section class="monitoring-panel monitoring-preview" aria-labelledby="monitoring-preview-title">
            <h3 id="monitoring-preview-title" class="monitoring-panel-title">Summary preview</h3>
            <span id="monitoring-review-badge" class="monitoring-draft-badge">DRAFT · REVIEW REQUIRED</span>

            <div class="monitoring-patient-summary">
                <strong id="monitoring-profile-name">Select a patient</strong>
                <p id="monitoring-period-text">Select a patient and reporting period to generate a summary.</p>
            </div>

            <div id="monitoring-feedback" class="monitoring-feedback" role="status" aria-live="polite"></div>
            <div id="monitoring-summary-loading" class="monitoring-loading" hidden>Loading patient activity…</div>

            <div id="monitoring-summary-sections" class="monitoring-summary-sections" hidden>
                <section id="monitoring-section-sessions" class="monitoring-summary-section" aria-labelledby="monitoring-sessions-title">
                    <h4 id="monitoring-sessions-title">Engagement overview</h4>
                    <p id="monitoring-summary-sessions"></p>
                </section>
                <section id="monitoring-section-platform" class="monitoring-summary-section" aria-labelledby="monitoring-platform-title">
                    <h4 id="monitoring-platform-title">Platform activity</h4>
                    <p id="monitoring-summary-platform"></p>
                </section>
                <section id="monitoring-section-modules" class="monitoring-summary-section" aria-labelledby="monitoring-modules-title">
                    <h4 id="monitoring-modules-title">Module / intervention activity</h4>
                    <p id="monitoring-summary-modules"></p>
                </section>
                <section id="monitoring-section-observations" class="monitoring-summary-section" aria-labelledby="monitoring-observations-title">
                    <h4 id="monitoring-observations-title">Recorded clinical observations</h4>
                    <p id="monitoring-summary-observations"></p>
                </section>
            </div>

            <div class="monitoring-notes-field">
                <label for="monitoring-notes">Clinician observations</label>
                <textarea id="monitoring-notes" rows="5" placeholder="Add or revise clinician-authored interpretation here."></textarea>
                <p class="monitoring-field-hint">Notes are clinician-authored and are not generated from activity data.</p>
            </div>

            <div class="monitoring-limitations">
                <h4>Limitations</h4>
                <p>App activity alone does not establish clinical improvement. Verify before documenting.</p>
            </div>
        </section>

        <div class="monitoring-side-column">
            <section class="monitoring-panel monitoring-settings" aria-labelledby="monitoring-settings-title">
                <h3 id="monitoring-settings-title" class="monitoring-panel-title">Summary settings</h3>
                <div class="monitoring-field">
                    <label for="monitoring-patient">Patient profile</label>
                    <select id="monitoring-patient" disabled>
                        <option value="">Loading patients…</option>
                    </select>
                </div>
                <div class="monitoring-field">
                    <label for="monitoring-days">Select period</label>
                    <select id="monitoring-days">
                        <option value="30">Last 30 days</option>
                        <option value="60">Last 60 days</option>
                    </select>
                </div>
                <fieldset class="monitoring-includes">
                    <legend>Include in draft</legend>
                    <label><input type="checkbox" id="monitoring-include-sessions" checked /> Session count and duration</label>
                    <label><input type="checkbox" id="monitoring-include-platform" checked /> Reflect XR vs Mobile</label>
                    <label><input type="checkbox" id="monitoring-include-modules" checked /> Module / intervention activity</label>
                    <label><input type="checkbox" id="monitoring-include-observations" checked /> Recorded clinical observations</label>
                </fieldset>
                <button type="button" class="monitoring-primary-button" id="monitoring-regenerate" disabled>Regenerate draft</button>
            </section>

            <section class="monitoring-panel monitoring-before-use" aria-labelledby="monitoring-before-use-title">
                <h3 id="monitoring-before-use-title" class="monitoring-panel-title">Before use</h3>
                <ul class="monitoring-checklist">
                    <li><i class="ri-check-line" aria-hidden="true"></i> Review selected date range</li>
                    <li><i class="ri-check-line" aria-hidden="true"></i> Confirm source metrics</li>
                    <li><i class="ri-check-line" aria-hidden="true"></i> Add clinical judgment</li>
                </ul>
                <div class="monitoring-actions">
                    <button type="button" class="monitoring-primary-button" id="monitoring-save" disabled>Save draft</button>
                    <button type="button" class="monitoring-secondary-button" id="monitoring-review" disabled>Mark reviewed</button>
                </div>
            </section>

            <section class="monitoring-panel monitoring-guidance" aria-labelledby="monitoring-guidance-title">
                <h3 id="monitoring-guidance-title" class="monitoring-panel-title">CPT / remote monitoring documentation checklist</h3>
                <p>Reference checklist only. The application does not verify billing eligibility or completion of these requirements.</p>
                <ul>
                    <li>Confirm the clinical evaluation and care plan.</li>
                    <li>Verify eligible activity and applicable time requirements.</li>
                    <li>Document required clinician communication.</li>
                    <li>Review and authenticate the clinical record.</li>
                </ul>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/services/monitoringDocumentation/indexService.js" asp-append-version="true"></script>
    <script src="~/js/controllers/monitoringDocumentation/indexController.js" asp-append-version="true"></script>
}
