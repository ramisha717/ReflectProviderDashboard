@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Reflect Provider Dashboard</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Provider Theme CSS -->
    <link rel="stylesheet" href="~/css/provider.css" asp-append-version="true" />
</head>
<body>
    <div class="provider-root">
        <!-- Sidebar Navigation -->
        <nav class="provider-sidebar">
            <div class="sidebar-brand-wrapper">
                <a href="@Url.Action("IndexPage", "Patients", new { area = "Provider" })" class="sidebar-brand">
                    <img src="~/images/reflect-xr-icon-white.png" alt="Reflect XR Logo" class="brand-logo" />
                    <div class="brand-text-block">
                        <span class="brand-title">REFLECT XR</span>
                        <span class="brand-sub">BY PERSISTENT TECHNOLOGY</span>
                    </div>
                </a>
                <div class="brand-badge">PROVIDER DASHBOARD</div>
            </div>

            <ul class="nav flex-column sidebar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Provider" asp-controller="Overview" asp-action="Index">
                        <i class="bi bi-grid-1x2 nav-icon"></i>
                        <span>Overview</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-area="Provider" asp-controller="Patients" asp-action="IndexPage">
                        <span class="active-dot"></span>
                        <i class="bi bi-people nav-icon"></i>
                        <span>Patients</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Provider" asp-controller="Progress" asp-action="Index">
                        <i class="bi bi-lightning-charge nav-icon"></i>
                        <span>Progress</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Provider" asp-controller="Monitoring" asp-action="Index">
                        <i class="bi bi-arrow-left-right nav-icon"></i>
                        <span>Monitoring</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Provider" asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-line nav-icon"></i>
                        <span>Reports</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <div class="sidebar-settings">
                    <a href="#" class="settings-link" title="Settings">
                        <i class="bi bi-gear me-1"></i> Settings
                    </a>
                </div>
                <div class="sidebar-user">
                    <div class="user-avatar">SM</div>
                    <div class="user-details">
                        <span class="user-name">Dr. Sarah Mitchell</span>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content Layout -->
        <div class="provider-main">
            <!-- Global Top Bar -->
            <header class="provider-header">
                <div class="header-title-group">
                    <h1 class="page-title">@ViewData["Title"]</h1>
                    <span class="header-subtitle">Find and review patient engagement records · Synthetic records</span>
                </div>
                <div class="header-controls">
                    <div class="header-search-box">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="header-search-input" placeholder="Search patients" />
                    </div>
                    <span class="demo-badge">DEMO DATA</span>
                </div>
            </header>

            <!-- Main Page View Content -->
            <main class="provider-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/provider.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
