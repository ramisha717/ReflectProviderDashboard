@{
    ViewData["ProviderScreenOwnsStyles"] = true;
    ViewData["Title"] = "Reports";
    ViewData["Subtitle"] = "Create a patient-specific report for clinical review.";
}

<div class="reports-page" id="reports-page"
     data-patients-url="@Url.Action("Index", "Patients", new { area = "Provider", format = "json" })"
     data-preview-url="@Url.Action("Preview", "Reports", new { area = "Provider" })"
     data-export-url="@Url.Action("Export", "Reports", new { area = "Provider" })"
     data-verify-url="@Url.Action("VerifySignedPackage", "Reports", new { area = "Provider" })"
     data-recent-url="@Url.Action("RecentExports", "Reports", new { area = "Provider" })">
    @Html.AntiForgeryToken()
    <div class="reports-notice"><span class="reports-prototype">PROTOTYPE · SYNTHETIC DATA</span><span>UX prototype only — not for clinical use.</span></div>
    <div class="reports-heading">
        <div><h1>Reports</h1><p>Export only the data needed for the selected workflow.</p></div>
        <button type="button" id="reports-new" class="reports-primary">+ New report</button>
    </div>
    <div id="reports-message" class="reports-message" role="status" aria-live="polite" hidden></div>
    <div class="reports-grid">
        <section class="reports-card reports-templates" aria-labelledby="reports-templates-title">
            <h2 id="reports-templates-title">Report templates</h2>
            <div class="reports-template"><h3>Engagement trends</h3><p>Activity across a date range</p><button type="button" data-template="0">Use template</button></div>
            <div class="reports-template"><h3>XR vs Mobile</h3><p>Compare platform use</p><button type="button" data-template="1">Use template</button></div>
            <div class="reports-template"><h3>Session log</h3><p>Detailed session listing</p><button type="button" data-template="2">Use template</button></div>
            <div class="reports-template"><h3>RTM status</h3><p>Workflow and documentation</p><button type="button" disabled title="This report template is not supported by the backend">Not available</button></div>
        </section>
        <section class="reports-card reports-config" aria-labelledby="reports-config-title">
            <h2 id="reports-config-title">Report configuration</h2>
            <div class="reports-fields">
                <div><label for="reports-patient">Patient</label><select id="reports-patient"><option value="">Loading patients…</option></select></div>
                <div><label for="reports-period">Date range</label><select id="reports-period"><option value="30">Last 30 days</option><option value="56">Last 8 weeks</option><option value="90">Last 90 days</option></select></div>
                <div><label for="reports-platform">Platform</label><select id="reports-platform"><option value="">All platforms</option><option value="Reflect XR">Reflect XR</option><option value="Reflect Mobile">Reflect Mobile</option></select></div>
            </div>
            <fieldset class="reports-options"><legend>Data to include</legend>
                <label><input type="checkbox" id="reports-count" checked /> Session count and duration</label>
                <label><input type="checkbox" id="reports-module" checked /> Module / intervention</label>
                <label><input type="checkbox" id="reports-platform-section" checked /> Platform</label>
                <label><input type="checkbox" id="reports-details" checked /> Session details where available</label>
            </fieldset>
            <div class="reports-actions">
                <button type="button" id="reports-preview-button" class="reports-primary">Generate preview</button>
                <button type="button" id="reports-pdf" class="reports-secondary" disabled>Export PDF</button>
                <button type="button" id="reports-csv" class="reports-secondary" disabled>Export CSV</button>
                <button type="button" id="reports-signed-pdf" class="reports-secondary" disabled>Signed PDF ZIP</button>
                <button type="button" id="reports-signed-csv" class="reports-secondary" disabled>Signed CSV ZIP</button>
            </div>
        </section>
    </div>
    <section class="reports-card reports-preview" id="reports-preview-panel" aria-labelledby="reports-preview-title" hidden>
        <h2 id="reports-preview-title">Report preview</h2>
        <p id="reports-preview-meta"></p><div id="reports-preview-sections"></div>
    </section>
    <section class="reports-card" aria-labelledby="reports-verify-title">
        <h2 id="reports-verify-title">Verify signed report</h2>
        <p>Upload a signed report ZIP. Verification uses the server's trusted signing key, not the public key inside the ZIP.</p>
        <label for="reports-signed-package">Signed report ZIP</label>
        <input id="reports-signed-package" type="file" accept=".zip,application/zip" />
        <button type="button" id="reports-verify" class="reports-secondary">Verify signature</button>
        <p id="reports-verify-result" role="status" aria-live="polite"></p>
    </section>
    <section class="reports-card reports-recent" aria-labelledby="reports-recent-title">
        <h2 id="reports-recent-title">Recent exports</h2>
        <div class="reports-table-scroll"><table><thead><tr><th scope="col">Report</th><th scope="col">Date</th><th scope="col">Scope</th><th scope="col">Format</th><th scope="col">Status</th></tr></thead><tbody id="reports-recent-body"><tr><td colspan="5">Select a patient to view recent exports.</td></tr></tbody></table></div>
    </section>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/provider.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/controllers/patients/dateFormatting.js" asp-append-version="true"></script>
    <script src="~/js/services/reports/indexService.js" asp-append-version="true"></script>
    <script src="~/js/controllers/reports/indexController.js" asp-append-version="true"></script>
}

