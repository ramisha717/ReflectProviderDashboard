@model Reflect.Web.Models.ViewModels.Patients.SessionDetails.PatientSessionDetailsViewModel
@using System.Globalization
@using Reflect.Web.Extensions
@{
    ViewData["ProviderScreenOwnsStyles"] = true;
    ViewData["Title"] = "Session Details";
    ViewData["Subtitle"] = "Recorded session details for " + Model.PatientCode;
    var eastern = TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
    var localStart = TimeZoneInfo.ConvertTime(Model.StartedAt, eastern);
    var date = Model.StartedAt.ToUsDateString();
    var startTime = localStart.ToString("h:mm tt", CultureInfo.InvariantCulture);
    var endTime = localStart.AddMinutes(Model.DurationMinutes)
    .ToString("h:mm tt", CultureInfo.InvariantCulture);
    var status = Model.RecordingStatus == "Succeeded" ? "Recorded successfully" : Model.RecordingStatus;
}
<div class="session-detail-page" id="session-detail-page">
    <div class="session-detail-notice">
        <strong>PROTOTYPE · SYNTHETIC DATA</strong>
        <span>UX prototype only — not for clinical use.</span>
    </div>
    <nav class="session-detail-nav" aria-label="Session navigation">
        <a asp-area="Provider" asp-controller="Patients" asp-action="IndexPage" class="btn btn-outline-secondary btn-sm">
            <i class="ri-arrow-left-line" aria-hidden="true"></i> All patients
        </a>
        <a asp-area="Provider" asp-controller="PatientSessionHistory" asp-action="IndexPage"
           asp-route-patientCode="@Model.PatientCode" class="btn btn-outline-secondary btn-sm">
            <i class="ri-history-line" aria-hidden="true"></i> Session history
        </a>
        <a asp-area="Provider" asp-controller="ClinicalResponse" asp-action="IndexPage"
           asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary btn-sm">
            <i class="ri-file-text-line" aria-hidden="true"></i> Clinical response &amp; observations
        </a>
        <a asp-area="Provider" asp-controller="Reports" asp-action="IndexPage"
           asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary btn-sm">
            <i class="ri-file-chart-line" aria-hidden="true"></i> Reports
        </a>
    </nav>
    <div class="session-detail-heading">
        <div><h1>Session Details</h1><p>@Model.PatientCode · Recorded session metadata</p></div>
        <span class="session-detail-review-state @(Model.ReviewStatus == "Needs Review" ? "needs-review" : "")">
            Patient status: @Model.ReviewStatus
        </span>
    </div>
    @if (TempData["SessionReviewMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <div class="session-detail-kpis">
        <section class="session-detail-card session-detail-kpi">
            <h2>Session ID</h2><p class="session-detail-id">@Model.SessionId</p>
            <small>Unique session identifier</small>
        </section>
        <section class="session-detail-card session-detail-kpi">
            <h2>Session date</h2><p>@date</p><small>@startTime – @endTime Eastern</small>
        </section>
        <section class="session-detail-card session-detail-kpi">
            <h2>Platform</h2><p>@Model.Platform</p><small>Recorded platform</small>
        </section>
        <section class="session-detail-card session-detail-kpi">
            <h2>Duration</h2><p>@Model.DurationMinutes min</p><small>Recorded duration</small>
        </section>
    </div>
    <div class="session-detail-main">
        <section class="session-detail-card" aria-labelledby="session-summary-title">
            <h2 id="session-summary-title">Session summary</h2>
            <dl class="session-detail-facts">
                <div><dt>Patient code</dt><dd>@Model.PatientCode</dd></div>
                <div><dt>Session ID</dt><dd class="session-detail-break">@Model.SessionId</dd></div>
                <div><dt>Module / intervention</dt><dd>@Model.ModuleName</dd></div>
                <div><dt>Platform</dt><dd>@Model.Platform</dd></div>
                <div><dt>Started at</dt><dd>@Model.StartedAt.ToUsDateTimeString() Eastern</dd></div>
                <div><dt>Duration</dt><dd>@Model.DurationMinutes minutes</dd></div>
                <div><dt>Recording status</dt><dd>@status</dd></div>
            </dl>
        </section>
        <section class="session-detail-card" aria-labelledby="session-data-title">
            <h2 id="session-data-title">Recorded activity</h2>
            <p>The current session repository contains session metadata only. It does not contain
               headset telemetry, biometric measurements, chronological events, protocol-completion
               percentages, or clinical outcome assessments.</p>
            <p>Only recorded information is displayed here. No clinical conclusions are inferred from activity.</p>
        </section>
    </div>
    <section class="session-detail-card session-detail-review" aria-labelledby="clinical-review-title">
        <h2 id="clinical-review-title">Clinical review</h2>
        <p>Flagging this session marks <strong>@Model.PatientCode</strong> as <strong>Needs Review</strong>
           in the patient record. This flag applies to the patient, not only to this session.</p>
        <form asp-area="Provider" asp-controller="Patients" asp-action="FlagSessionForReview" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" value="@Model.PatientId" />
            <input type="hidden" name="sessionId" value="@Model.SessionId" />
            <button type="submit" class="btn btn-primary-navy" disabled="@(Model.ReviewStatus == "Needs Review")">
                <i class="ri-flag-line" aria-hidden="true"></i>
                @(Model.ReviewStatus == "Needs Review" ? "Already flagged for review" : "Flag for clinical review")
            </button>
        </form>
        <p class="session-detail-footnote">To add a clinician-authored observation, use Clinical Response &amp; Observations.</p>
    </section>
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/provider.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/session-details.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/controllers/patients/sessionDetailsController.js" asp-append-version="true"></script>
}