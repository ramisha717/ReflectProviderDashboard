@model Reflect.Web.Models.ViewModels.Overview.Index.OverviewIndexViewModel
@using System.Globalization
@using System.Text.Json
@using Reflect.Web.Extensions
@{
    Layout = "_ProviderLayout";
    ViewData["Title"] = "Overview";
    ViewData["Subtitle"] = "Clinical summary of patient engagement — Synthetic data only.";

    var patientsUrl = Url.Action("IndexPage", "Patients", new { area = "Provider" });
    var eastern = TimeZoneInfo.FindSystemTimeZoneById("America/New_York");
    var us = CultureInfo.GetCultureInfo("en-US");
    var chartLabels = Model.WeeklyEngagement.Select(x =>
        TimeZoneInfo.ConvertTime(x.WeekStart, eastern).ToString("MMM d", us)).ToArray();
    var xrMinutes = Model.WeeklyEngagement.Select(x => x.ReflectXRMinutes).ToArray();
    var mobileMinutes = Model.WeeklyEngagement.Select(x => x.ReflectMobileMinutes).ToArray();
}

<!-- KPI Cards -->
<div id="overview-content">
    <div class="kpi-grid">
        <div class="kpi-card card custom-card">
            <div class="kpi-label"><i class="ri-group-line me-1" aria-hidden="true"></i> Total Patients</div>
            <div class="kpi-value" id="kpi-total-patients">@Model.TotalPatients</div>
            <div class="kpi-sub">Enrolled in programme</div>
        </div>
        <div class="kpi-card card custom-card">
            <div class="kpi-label"><i class="ri-pulse-line me-1" aria-hidden="true"></i> Active Patients</div>
            <div class="kpi-value" id="kpi-active-patients">@Model.ActivePatients</div>
            <div class="kpi-sub">Currently active in programme</div>
        </div>
        <div class="kpi-card card custom-card">
            <div class="kpi-label"><i class="ri-calendar-check-line me-1" aria-hidden="true"></i> Sessions This Month</div>
            <div class="kpi-value" id="kpi-sessions-month">@Model.SessionsThisMonth</div>
            <div class="kpi-sub">XR + Mobile combined</div>
        </div>
        <div class="kpi-card card custom-card">
            <div class="kpi-label"><i class="ri-error-warning-line me-1" aria-hidden="true"></i> Needs Review</div>
            <div class="kpi-value" id="kpi-patients-review">@Model.PatientsNeedingReview</div>
            <div class="kpi-sub">Patients flagged for attention</div>
        </div>
    </div>

    <!-- Real-time Trends Chart -->
    <div class="dash-card card custom-card">
        <div class="dash-card-header">
            <h3 class="dash-card-title">Real-time Trends</h3>
            <span class="text-muted small">Weekly engagement by platform</span>
        </div>
        <div class="dash-card-body">
            <div style="position:relative;height:220px;">
                <canvas id="weekly-engagement-chart"
                        role="img"
                        aria-label="Weekly engagement in minutes for Reflect XR and Reflect Mobile"
                        data-labels="@JsonSerializer.Serialize(chartLabels)"
                        data-xr="@JsonSerializer.Serialize(xrMinutes)"
                        data-mobile="@JsonSerializer.Serialize(mobileMinutes)"></canvas>
            </div>
        </div>
        <div class="chart-legend">
            <div class="chart-legend-item"><span class="legend-dot navy"></span> Reflect XR</div>
            <div class="chart-legend-item"><span class="legend-dot coral"></span> Reflect Mobile</div>
        </div>
    </div>

    <form asp-area="Provider" asp-controller="Overview" asp-action="Index" method="get" class="card custom-card p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="inactivityThresholdDays">Inactivity threshold (days)</label>
                <input class="form-control" id="inactivityThresholdDays" name="inactivityThresholdDays" type="number" min="1" step="1" value="@Model.InactivityThresholdDays" placeholder="Disabled" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="frequencyDeclineThresholdPercent">Frequency decline threshold (%)</label>
                <input class="form-control" id="frequencyDeclineThresholdPercent" name="frequencyDeclineThresholdPercent" type="number" min="1" max="100" step="1" value="@Model.FrequencyDeclineThresholdPercent" placeholder="Disabled" />
            </div>
            <div class="col-12 col-md-4"><button type="submit" class="btn btn-primary w-100">Apply attention thresholds</button></div>
        </div>
    </form>
    <!-- Attention Queue + Recent Activity -->
    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <div class="dash-card card custom-card h-100">
                <div class="dash-card-header">
                    <h3 class="dash-card-title">Patients Needing Attention</h3>
                    <a asp-area="Provider" asp-controller="Overview" asp-action="AttentionReview" asp-route-inactivityThresholdDays="@Model.InactivityThresholdDays" asp-route-frequencyDeclineThresholdPercent="@Model.FrequencyDeclineThresholdPercent" class="profile-link small">View queue &rarr;</a>
                </div>
                <div class="dash-card-body p-0">
                    @if (Model.AttentionQueue.Count == 0)
                    {
                        <div id="attention-empty" class="p-4 text-center text-muted">
                            <i class="ri-checkbox-circle-line d-block fs-4 mb-2" aria-hidden="true"></i>
                            No patients require attention at the moment.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table id="attention-table" class="attention-table table">
                                <thead><tr><th scope="col">Patient Code</th><th scope="col">Signal</th><th scope="col">Reason</th></tr></thead>
                                <tbody>
                                @foreach (var row in Model.AttentionQueue)
                                {
                                    <tr>
                                        <td>
                                            <a asp-area="Provider" asp-controller="Patients" asp-action="IndexPage"
                                               asp-route-patientId="@row.PatientId" class="fw-bold text-decoration-none">
                                                @row.PatientCode <i class="ri-arrow-right-line" aria-hidden="true"></i>
                                            </a>
                                        </td>
                                        <td><span class="badge bg-warning-subtle text-warning-emphasis">@row.SignalType</span></td>
                                        <td>@row.Reason</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="dash-card card custom-card h-100">
                <div class="dash-card-header"><h3 class="dash-card-title">Recent Activity</h3></div>
                <div class="dash-card-body p-0">
                    @if (Model.RecentActivity.Count == 0)
                    {
                        <div id="activity-empty" class="p-4 text-center text-muted">No recent activity found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table id="activity-table" class="activity-table table">
                                <thead><tr><th scope="col">Patient</th><th scope="col">Platform</th><th scope="col">Date</th><th scope="col">Duration</th></tr></thead>
                                <tbody>
                                @foreach (var row in Model.RecentActivity)
                                {
                                    <tr>
                                        <td>
                                            <a asp-area="Provider" asp-controller="Patients" asp-action="IndexPage"
                                               asp-route-patientId="@row.PatientId" class="fw-bold text-decoration-none">@row.PatientCode</a>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@row.Platform</span></td>
                                        <td>@row.StartedAt.ToUsDateString()</td>
                                        <td>
                                            <a asp-area="Provider" asp-controller="Patients" asp-action="SessionDetails"
                                               asp-route-patientId="@row.PatientId" asp-route-sessionId="@row.SessionId"
                                               class="text-decoration-none fw-semibold">
                                                @row.DurationMinutes min <i class="ri-external-link-line ms-1" aria-hidden="true"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <a href="@patientsUrl" class="quick-action-btn primary"><i class="ri-group-line" aria-hidden="true"></i> View Patients</a>
        <a asp-area="Provider" asp-controller="Reports" asp-action="IndexPage" class="quick-action-btn secondary">
            <i class="ri-bar-chart-line" aria-hidden="true"></i> Generate Reports
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/js/controllers/overview/indexController.js" asp-append-version="true" defer></script>
}

