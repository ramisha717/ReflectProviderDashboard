@{
    Layout = "_ProviderLayout";
    ViewData["Title"] = "Monitoring";
    ViewData["Subtitle"] = "Patient 501: Clinical monitoring documentation status";
}

<!-- Breadcrumb -->
<div style="font-size:12px;color:var(--text-muted);margin-bottom:12px;">
    <span>Monitoring</span> <span class="mx-1">/</span> <span style="color:var(--text-dark);font-weight:600;">Documentation & compliance</span>
</div>

@await Html.PartialAsync("_PatientSubNav", "monitoring")

<!-- Header Action Row -->
<div class="content-header">
    <div>
        <h2 class="content-title">Monitoring</h2>
        <p class="content-subtitle">Patient 501: Clinical monitoring documentation status and billing compliance log.</p>
    </div>
    <div>
        <button class="btn btn-outline-secondary btn-sm" style="border-radius:var(--btn-radius);font-weight:600;font-size:12.5px;padding:8px 16px;">
            <i class="bi bi-file-earmark-arrow-down me-1"></i> Export documentation summary
        </button>
    </div>
</div>

<!-- 4 KPI Cards -->
<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-label"><i class="bi bi-calendar3 me-1"></i> Recorded Days</div>
        <div class="kpi-value">13</div>
        <div class="kpi-sub">Days with active sessions</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label"><i class="bi bi-clock-history me-1"></i> Total Sessions</div>
        <div class="kpi-value">18</div>
        <div class="kpi-sub">Across XR and Mobile</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label"><i class="bi bi-stopwatch me-1"></i> Engagement Duration</div>
        <div class="kpi-value">312 min</div>
        <div class="kpi-sub">Logged therapeutic usage</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label"><i class="bi bi-check2-square me-1"></i> Response Review</div>
        <div class="kpi-value">2</div>
        <div class="kpi-sub">Clinical sign-offs completed</div>
    </div>
</div>

<!-- Longitudinal Monitoring Table Card -->
<div class="table-card mb-4">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="background:var(--bg-table-header);">
        <h3 class="dash-card-title" style="font-size:13px;margin:0;">Longitudinal monitoring summary</h3>
        <span class="badge bg-light text-dark border">Billing cycle: October 2026</span>
    </div>
    <div class="table-responsive">
        <table class="patients-table">
            <thead>
                <tr>
                    <th>DATE RANGE</th>
                    <th>SESSIONS</th>
                    <th>DURATION</th>
                    <th>ENGAGEMENT RATE</th>
                    <th>STATUS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold" style="color:var(--text-dark);">10/01/2026 – 10/18/2026</td>
                    <td>18 sessions</td>
                    <td>312 min</td>
                    <td><span class="badge bg-light text-success border">88.5% Adherence</span></td>
                    <td><span class="badge bg-success" style="font-size:11px;">Completed</span></td>
                </tr>
                <tr>
                    <td class="fw-bold" style="color:var(--text-dark);">09/01/2026 – 09/30/2026</td>
                    <td>24 sessions</td>
                    <td>420 min</td>
                    <td><span class="badge bg-light text-success border">91.2% Adherence</span></td>
                    <td><span class="badge bg-success" style="font-size:11px;">Completed</span></td>
                </tr>
                <tr>
                    <td class="fw-bold" style="color:var(--text-dark);">08/01/2026 – 08/31/2026</td>
                    <td>21 sessions</td>
                    <td>385 min</td>
                    <td><span class="badge bg-light text-success border">87.0% Adherence</span></td>
                    <td><span class="badge bg-success" style="font-size:11px;">Completed</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Bottom Section: Checklist + Sign-off -->
<div class="row g-4">
    <!-- Documentation Checklist -->
    <div class="col-12 col-md-7">
        <div class="dash-card h-100 mb-0">
            <div class="dash-card-header">
                <h3 class="dash-card-title">Documentation checklist</h3>
                <span style="font-size:11px;color:var(--text-muted);">CPT / Remote Monitoring Requirements</span>
            </div>
            <div class="dash-card-body p-3">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" checked id="chk1" />
                    <label class="form-check-label small" for="chk1">
                        <strong>Initial clinical evaluation and therapeutic care plan active</strong>
                        <div class="text-muted" style="font-size:11.5px;">Protocol setup completed on 07/15/2026.</div>
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" checked id="chk2" />
                    <label class="form-check-label small" for="chk2">
                        <strong>Minimum active therapeutic engagement data recorded</strong>
                        <div class="text-muted" style="font-size:11.5px;">13 of 16 required days logged this 30-day period.</div>
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" checked id="chk3" />
                    <label class="form-check-label small" for="chk3">
                        <strong>Two-way clinician communication and check-in logged</strong>
                        <div class="text-muted" style="font-size:11.5px;">Last interactive check-in: 10/15/2026 by Dr. Sarah Mitchell.</div>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked id="chk4" />
                    <label class="form-check-label small" for="chk4">
                        <strong>Monthly clinical progress note drafted and reviewed</strong>
                        <div class="text-muted" style="font-size:11.5px;">Summary generated from synthetic patient telemetry.</div>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Status & Sign-off Panel -->
    <div class="col-12 col-md-5">
        <div class="dash-card h-100 mb-0">
            <div class="dash-card-header">
                <h3 class="dash-card-title">Documentation status & sign-off</h3>
            </div>
            <div class="dash-card-body p-3">
                <div class="mb-3">
                    <label class="small fw-bold text-muted text-uppercase mb-1" style="font-size:11px;">Current Status</label>
                    <div>
                        <span class="badge" style="background:#DCFCE7;color:#15803D;font-weight:700;font-size:12px;padding:6px 12px;border:1px solid #BBF7D0;">
                            <i class="bi bi-shield-check me-1"></i> READY FOR SIGN-OFF
                        </span>
                    </div>
                </div>

                <div class="p-3 rounded-2 mb-3" style="background:var(--bg-table-header);border:1px solid var(--border-light);font-size:12px;color:var(--text-body);">
                    <div><strong>Reviewing Clinician:</strong> Dr. Sarah Mitchell</div>
                    <div><strong>License:</strong> MD-99201</div>
                    <div class="text-muted mt-1" style="font-size:11px;">Last verified: Today, 10/18/2026 at 14:30 EST</div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-primary-navy btn-sm py-2" type="button" style="border-radius:var(--btn-radius);font-weight:600;">
                        <i class="bi bi-check2-all me-1"></i> Verify & Sign-off
                    </button>
                    <button class="btn btn-outline-secondary btn-sm py-2" type="button" style="border-radius:var(--btn-radius);font-weight:600;">
                        <i class="bi bi-save me-1"></i> Save Draft
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
