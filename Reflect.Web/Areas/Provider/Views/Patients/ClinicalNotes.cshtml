@{
    Layout = "_ProviderLayout";
    ViewData["Title"] = "Clinical Notes";
    ViewData["Subtitle"] = "Patient 501: Summary notes and assessments";
}

<!-- Breadcrumb -->
<div style="font-size:12px;color:var(--text-muted);margin-bottom:12px;">
    <a asp-area="Provider" asp-controller="Patients" asp-action="IndexPage" class="text-decoration-none" style="color:var(--text-muted);">Patients</a>
    <span class="mx-1">/</span>
    <span style="color:var(--text-muted);">Patient 501</span>
    <span class="mx-1">/</span>
    <span style="color:var(--text-dark);font-weight:600;">Clinical Notes</span>
</div>

@await Html.PartialAsync("_PatientSubNav", "clinical-notes")

<!-- Header Action Row -->
<div class="content-header">
    <div>
        <h2 class="content-title">Clinical Notes</h2>
        <p class="content-subtitle">Patient 501: Summary notes, clinical progress documentation, and provider assessments.</p>
    </div>
    <div>
        <button class="btn btn-primary-navy btn-sm" id="btn-open-create-note" type="button" style="border-radius:var(--btn-radius);font-weight:600;font-size:12.5px;padding:8px 16px;">
            <i class="bi bi-plus-lg me-1"></i> Create Clinical Note
        </button>
    </div>
</div>

<!-- Filter Pills -->
<div class="filter-toolbar mb-3">
    <div class="filter-pills">
        <button class="pill-btn active" type="button">All notes (3)</button>
        <button class="pill-btn" type="button">Active notes (1)</button>
        <button class="pill-btn" type="button">Completed notes (2)</button>
    </div>
    <div style="font-size:12px;color:var(--text-muted);">
        <i class="bi bi-shield-lock me-1"></i> Encrypted clinical record
    </div>
</div>

<!-- Existing Clinical Notes Summary Table Card -->
<div class="table-card mb-4">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="background:var(--bg-table-header);">
        <h3 class="dash-card-title" style="font-size:13px;margin:0;">Existing clinician notes summary</h3>
        <span class="badge bg-light text-dark border">Showing 3 records</span>
    </div>
    <div class="table-responsive">
        <table class="patients-table">
            <thead>
                <tr>
                    <th>DATE</th>
                    <th>AUTHOR</th>
                    <th>NOTE TYPE</th>
                    <th>SUBJECT / FOCUS</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold" style="color:var(--text-dark);">10/18/2026</td>
                    <td>Dr. Sarah Mitchell</td>
                    <td><span class="badge bg-light text-dark border">Evaluation</span></td>
                    <td>Mid-protocol anxiety reduction & VR tolerance review</td>
                    <td><span class="badge" style="background:#DCFCE7;color:#15803D;">Completed</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary py-1 px-2 btn-edit-note" data-id="CN-2026-081" data-date="10/18/2026" data-type="Evaluation" data-subject="Mid-protocol anxiety reduction & VR tolerance review" data-text="Patient tolerated 24-minute Cognitive Calm session with steady autonomic stability. Recommending continuation of outpatient regimen." style="font-size:12px;border-radius:4px;">
                            <i class="bi bi-pencil me-1"></i> View / Edit
                        </button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold" style="color:var(--text-dark);">10/04/2026</td>
                    <td>Dr. Sarah Mitchell</td>
                    <td><span class="badge bg-light text-dark border">Progress</span></td>
                    <td>Initial bi-weekly adherence & modality split assessment</td>
                    <td><span class="badge" style="background:#DCFCE7;color:#15803D;">Completed</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary py-1 px-2 btn-edit-note" data-id="CN-2026-074" data-date="10/04/2026" data-type="Progress" data-subject="Initial bi-weekly adherence & modality split assessment" data-text="Patient started XR headset integration well. Modality transition smooth." style="font-size:12px;border-radius:4px;">
                            <i class="bi bi-pencil me-1"></i> View / Edit
                        </button>
                    </td>
                </tr>
                <tr>
                    <td class="fw-bold" style="color:var(--text-dark);">09/15/2026</td>
                    <td>Dr. Sarah Mitchell</td>
                    <td><span class="badge bg-light text-dark border">Intake</span></td>
                    <td>Remote monitoring onboarding and consent verification</td>
                    <td><span class="badge" style="background:#DCFCE7;color:#15803D;">Completed</span></td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary py-1 px-2 btn-edit-note" data-id="CN-2026-060" data-date="09/15/2026" data-type="Intake" data-subject="Remote monitoring onboarding and consent verification" data-text="Patient oriented to Reflect XR hardware and mobile companion application. Baseline PHQ-9 recorded." style="font-size:12px;border-radius:4px;">
                            <i class="bi bi-pencil me-1"></i> View / Edit
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Bottom Row: Note History + Provider Communication Records -->
<div class="row g-4 mb-4">
    <div class="col-12 col-md-6">
        <div class="dash-card h-100 mb-0">
            <div class="dash-card-header">
                <h3 class="dash-card-title">Note history</h3>
            </div>
            <div class="dash-card-body p-3">
                <ul class="list-unstyled mb-0" style="font-size:13px;">
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span><strong>10/18/2026</strong> · Evaluation Review</span>
                        <span class="text-success small fw-bold">Signed</span>
                    </li>
                    <li class="d-flex justify-content-between py-2 border-bottom">
                        <span><strong>10/04/2026</strong> · Bi-weekly Progress</span>
                        <span class="text-success small fw-bold">Signed</span>
                    </li>
                    <li class="d-flex justify-content-between py-2">
                        <span><strong>09/15/2026</strong> · Intake Attestation</span>
                        <span class="text-success small fw-bold">Signed</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="dash-card h-100 mb-0">
            <div class="dash-card-header">
                <h3 class="dash-card-title">Provider communication records</h3>
            </div>
            <div class="dash-card-body p-3">
                <div class="p-3 rounded-2 mb-2" style="background:var(--bg-table-header);border:1px solid var(--border-light);font-size:12.5px;">
                    <div class="fw-bold" style="color:var(--text-dark);">Care Coordination Check-in</div>
                    <div class="text-muted small">10/15/2026 · Dr. Sarah Mitchell discussed session schedule with patient. Patient confirmed comfortable with evening sessions.</div>
                </div>
                <div class="text-muted small" style="font-size:11px;">
                    <i class="bi bi-info-circle me-1"></i> All interactions are logged for remote patient monitoring billing compliance.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Clinical Note Modal (Screen 06 Edit Clinical Note) -->
<div class="modal fade" id="editNoteModal" tabindex="-1" aria-labelledby="editNoteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:var(--card-radius);overflow:hidden;">
            <div class="modal-header" style="background:var(--bg-sidebar);color:var(--text-white);padding:18px 24px;">
                <div>
                    <h5 class="modal-title fw-bold" id="editNoteModalLabel" style="font-size:16px;">
                        <i class="bi bi-journal-text me-2"></i>Edit Clinical Note
                    </h5>
                    <div style="font-size:11px;color:rgba(255,255,255,0.7);">Patient 501: Complete single-page edit form</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="background:var(--bg-body);">
                <div class="row g-4">
                    <!-- Left Form Area (70%) -->
                    <div class="col-12 col-lg-8">
                        <div class="p-4 bg-white rounded-3 border">
                            <div class="row g-3 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label" style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">NOTE ID</label>
                                    <input type="text" id="modal-note-id" class="form-control" value="CN-2026-081" readonly style="font-size:12.5px;background:#F8F9FC;" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">PATIENT CODE</label>
                                    <input type="text" class="form-control" value="Patient 501" readonly style="font-size:12.5px;background:#F8F9FC;" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">NOTE DATE</label>
                                    <input type="date" id="modal-note-date" class="form-control" value="2026-10-18" style="font-size:12.5px;" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">NOTE TYPE</label>
                                    <select id="modal-note-type" class="form-select" style="font-size:12.5px;">
                                        <option value="Evaluation" selected>Evaluation</option>
                                        <option value="Progress">Progress</option>
                                        <option value="Intake">Intake</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">SUBJECT / FOCUS</label>
                                <input type="text" id="modal-note-subject" class="form-control" value="Mid-protocol anxiety reduction & VR tolerance review" style="font-size:13px;" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;">CLINICAL OBSERVATION & NOTE TEXT</label>
                                <textarea id="modal-note-text" class="form-control" rows="7" style="font-size:13px;line-height:1.6;">Patient tolerated 24-minute Cognitive Calm session with steady autonomic stability. Heart rate variability trended toward baseline within 6 minutes of starting the immersive visual environment. No dizziness or motion sensitivity reported. Recommending continuation of current 3x weekly regimen.</textarea>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" checked id="chk-confidential" />
                                <label class="form-check-label small" for="chk-confidential">
                                    <strong>Confidential Clinical Record</strong> (Restricted to authorized clinical care team)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Right Instructions Panel (30%) -->
                    <div class="col-12 col-lg-4">
                        <div class="p-4 bg-white rounded-3 border h-100">
                            <div style="font-size:13px;font-weight:700;color:var(--text-dark);text-transform:uppercase;margin-bottom:12px;border-bottom:1px solid var(--border-light);padding-bottom:6px;">
                                Provider Guidelines Checklist
                            </div>
                            <ol class="small text-muted ps-3 mb-4" style="line-height:1.6;font-size:12px;">
                                <li class="mb-2"><strong>Confirm patient identity:</strong> Cross-check telemetry code with patient chart.</li>
                                <li class="mb-2"><strong>Review session metrics:</strong> Verify duration, completion rate, and platform telemetry before saving.</li>
                                <li class="mb-2"><strong>Document response:</strong> Record subjective self-reports and any adverse events.</li>
                                <li><strong>CPT Compliance:</strong> Note duration and clinical management elements for billing validation.</li>
                            </ol>
                            <div class="p-3 rounded-2" style="background:#EFF6FF;border:1px solid #BFDBFE;font-size:11.5px;color:#1E40AF;">
                                <i class="bi bi-shield-check me-1"></i> Saving as <em>Complete</em> stamps this note with your digital clinician ID and locks editing.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="background:var(--bg-table-header);border-top:1px solid var(--border-light);padding:14px 24px;">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" style="border-radius:var(--btn-radius);font-weight:600;">Cancel</button>
                <button type="button" class="btn btn-outline-primary btn-sm px-3" data-bs-dismiss="modal" style="border-radius:var(--btn-radius);font-weight:600;">Save Draft</button>
                <button type="button" class="btn btn-primary-navy btn-sm px-4" data-bs-dismiss="modal" style="border-radius:var(--btn-radius);font-weight:600;">
                    <i class="bi bi-check2-circle me-1"></i> Save & Complete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('editNoteModal');
        var bsModal = window.bootstrap && bootstrap.Modal ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;

        document.getElementById('btn-open-create-note').addEventListener('click', function() {
            document.getElementById('modal-note-id').value = 'CN-2026-' + Math.floor(100 + Math.random() * 900);
            document.getElementById('modal-note-subject').value = 'Clinical follow-up note';
            document.getElementById('modal-note-text').value = '';
            if (bsModal) bsModal.show();
        });

        document.querySelectorAll('.btn-edit-note').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.getElementById('modal-note-id').value = this.getAttribute('data-id');
                document.getElementById('modal-note-subject').value = this.getAttribute('data-subject');
                document.getElementById('modal-note-text').value = this.getAttribute('data-text');
                document.getElementById('modal-note-type').value = this.getAttribute('data-type');
                if (bsModal) bsModal.show();
            });
        });
    });
</script>
}
