@model Reflect.Web.Models.ViewModels.Overview.Index.OverviewIndexViewModel
@{
    Layout = "_ProviderLayout";
    ViewData["Title"] = "Attention Review";
    ViewData["Subtitle"] = "Review patient attention signals.";
    var reviewCount = Model.AttentionQueue.Count(x => x.SignalType == "Needs Review");
    var activityCount = Model.AttentionQueue.Count - reviewCount;
}
<div class="content-header">
    <div><h1 class="content-title">Attention Review</h1><p class="content-subtitle">Review current patient attention signals.</p></div>
    <a asp-area="Provider" asp-controller="Overview" asp-action="Index"
       asp-route-inactivityThresholdDays="@Model.InactivityThresholdDays"
       asp-route-frequencyDeclineThresholdPercent="@Model.FrequencyDeclineThresholdPercent"
       class="btn btn-outline-secondary btn-sm">Back to Overview</a>
</div>
<div class="kpi-grid mb-3">
    <div class="kpi-card card custom-card"><div class="kpi-label">Total Flagged</div><div class="kpi-value">@Model.AttentionQueue.Count</div><div class="kpi-sub">Open queue items</div></div>
    <div class="kpi-card card custom-card"><div class="kpi-label">Needs Review</div><div class="kpi-value">@reviewCount</div><div class="kpi-sub">Clinical review signals</div></div>
    <div class="kpi-card card custom-card"><div class="kpi-label">Activity Alerts</div><div class="kpi-value">@activityCount</div><div class="kpi-sub">Inactivity and frequency decline</div></div>
</div>
<div class="table-card card custom-card mb-4">
    <div class="card-header"><div class="card-title">Attention Items Queue</div></div>
    <div class="card-body table-responsive">
        <table class="table table-bordered text-nowrap align-middle">
            <thead><tr><th>Patient</th><th>Signal</th><th>Reason</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var item in Model.AttentionQueue)
            {
                <tr>
                    <td><a asp-area="Provider" asp-controller="Patients" asp-action="IndexPage" asp-route-patientId="@item.PatientId">@item.PatientCode</a></td>
                    <td>@item.SignalType</td><td class="text-wrap">@item.Reason</td><td>Needs attention</td>
                    <td>
                        <form asp-area="Provider" asp-controller="Overview" asp-action="MarkReviewed" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="patientId" value="@item.PatientId" />
                            <input type="hidden" name="signalType" value="@item.SignalType" />
                            <input type="hidden" name="inactivityThresholdDays" value="@Model.InactivityThresholdDays" />
                            <input type="hidden" name="frequencyDeclineThresholdPercent" value="@Model.FrequencyDeclineThresholdPercent" />
                            <button type="submit" class="btn btn-primary btn-sm">Mark Reviewed</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.AttentionQueue.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">No patients currently require attention.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
